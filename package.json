{
  "name": "infotb-rea",
  "version": "1.0.0",
  "private": true,
  "description": "InfoTB București–Ilfov (REA Remake) — aplicație ușoară Web & Android bazată pe TPBI API, fără login și fără plăți, cu hartă integrată fără cheie API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "sync:data": "node scripts/build-tpbi-dataset.mjs",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "leaflet": "^1.9.4",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@preact/preset-vite": "^2.9.3",
    "@types/leaflet": "^1.9.16",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
